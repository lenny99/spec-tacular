ApiScript = { SOI ~ (Schema | Api | Type)* ~ EOI }

// Types
Schema         = { "schema" ~ Identifier ~ "{" ~ Fields ~ "}" }
Type           = { "type" ~ Identifier ~ ":" ~ TypeDefinition }
TypeDefinition = { Kind | List | Identifier }
Kind           = { Primitive ~ ("#" ~ Format)? }
Fields         = { Field* }
Field          = { Identifier ~ ":" ~ TypeDefinition ~ Optional? }
Optional       = { "?" }
List           = { "[" ~ TypeDefinition ~ "]" }
Format         = { "date" | "date-time" | "password" | "byte" | "binary" | Identifier }
Primitive      = { "string" | "number" | "integer" | "boolean" }

// Annotations
Annotations = { Annotation* }
Annotation  = { "@" ~ Identifier ~ ("(" ~ Value ~ ")")? }

// Values
Value       = _{ String | ArrayValue | Identifier | NumberValue }
ArrayValue  = @{ "[" ~ ((String | TypeDefinition) ~ ",")* }
NumberValue = @{ ASCII_DIGIT* }

// Api
Api         =  { Annotations ~ "api" ~ Identifier ~ Version ~ "{" ~ ApiBody ~ "}" }
ApiBody     =  { (ApiPath | Server)* }
Server      =  { "server" ~ String ~ ("{" ~ "}")? }
Version     = _{ String }
ApiPath     =  { "path" ~ "\"" ~ UrlPath ~ "\"" ~ "{" ~ Endpoints ~ "}" }
Endpoints   =  { Endpoint* }
UrlPath     =  { Path }
Endpoint    =  { Method ~ OperationId ~ "(" ~ Parameters? ~ ")" ~ "{" ~ Responses ~ "}" }
Method      =  { "GET" | "PUT" | "POST" | "DELETE" | "PATCH" }
OperationId = _{ Identifier }
Parameters  =  { Parameter ~ ("," ~ Parameter)* }
Parameter   =  { Annotations ~ Identifier ~ ":" ~ TypeDefinition }
Responses   =  { Response* }
Response    =  { HttpCode ~ ":" ~ TypeDefinition }

// General Patterns
HttpCode   = @{ ASCII_DIGIT+ }
Path       = @{ (ASCII_ALPHANUMERIC | "/" | "{" | "}")* }
Identifier = @{ ASCII_ALPHA ~ ASCII_ALPHANUMERIC* }
String     = @{ "\"" ~ (!("\"") ~ ANY)* ~ "\"" }

// VERSION    = _{ ASCII_ALPHANUMERIC | "." }
WHITESPACE = _{ " " | NEWLINE }
