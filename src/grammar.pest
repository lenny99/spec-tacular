ApiScript = { SOI ~ (Schema | Api | Type)* ~ EOI }

Schema = { "schema" ~ IDENTIFIER ~ "{" ~ Fields ~ "}" }
Type   = { "type" ~ IDENTIFIER ~ ":" ~ TypeDef }

Fields   = { Field* }
Optional = { "?" }
TypeDef  = {
    Primitive ~ ("#" ~ Format)?
  | List
  | IDENTIFIER
}

List = { "[" ~ TypeDef ~ "]" }

Format    = { "date" | "date-time" | "password" | "byte" | "binary" | IDENTIFIER }
Field     = { IDENTIFIER ~ ":" ~ TypeDef ~ Optional? }
Primitive = { "string" | "number" | "integer" | "boolean" }

Api         =  { "api" ~ IDENTIFIER ~ Version ~ "{" ~ Paths ~ "}" }
Paths       =  { Path* }
Version     = @{ "\"" ~ VERSION ~ "\"" }
Path        =  { "path" ~ "\"" ~ UrlPath ~ "\"" ~ "{" ~ Endpoints ~ "}" }
Endpoints   =  { Endpoint* }
UrlPath     =  { PATH }
Endpoint    =  { Method ~ OperationId ~ "(" ~ Parameters? ~ ")" ~ "{" ~ Responses ~ "}" }
Method      =  { "GET" | "PUT" | "POST" | "DELETE" | "PATCH" }
OperationId = _{ IDENTIFIER }
Parameters  =  { Parameter ~ ("," ~ Parameter)* }
Annotations =  { Annotation* }
Annotation  =  { "@" ~ IDENTIFIER ~ ("(" ~ ")")? }
Parameter   =  { Annotations ~ IDENTIFIER ~ ":" ~ TypeDef }
Responses   =  { Response* }
Response    =  { HTTP_CODE ~ ":" ~ TypeDef }

HTTP_CODE  = @{ ASCII_DIGIT+ }
PATH       = @{ (ASCII_ALPHANUMERIC | "/" | "{" | "}")* }
VERSION    = @{ (ASCII_DIGIT | ".")+ }
WHITESPACE = _{ " " | NEWLINE }
IDENTIFIER = @{ ASCII_ALPHA ~ ASCII_ALPHANUMERIC* }
