
schema Pet {
  id: integer#int64
  name: string
  tag: string?
}

type Pets : [Pet]

type Int64 : integer#int64

schema Error {
  code: integer#int32
  message: string
}

/// HELLO

@termsOfService("https://link")
@contact("Max Mustermann")
@license("MIT")
@Query({description: "How many items to return at one time"})
api "Swagger Petstore" "0.0.1" {

  path "/pets" {
    GET listPets(@Max(100) limit: Int64?) {
      @Header({
        name: "x-next"
        schema: string
        description: "A link to the next page of responses"
      })
      200:     Pets
      default: Error
    }
    POST createPets() {
      201: undefined
      default: Error
    }
  }

  // TODO another syntax for tags because it results in api-classes
  // TODO? declare path params at path level
  path "/pets/{petId}" {
    GET showPetById(@Path petId: string) {
      200: Pet
      default: Error
    }
  }
}
