schema Date = string#date

schema Booking = {
  delivery: string#date
  address: string
}

schema ContainerId = string

schema Container = {
  id: ContainerId
  tare: integer?
  gross: integer?
}

schema Problem = {
  description: string
}

api ContainerApi "0.0.1" {
  path "/containers" {
    GET listContainers(@Query @Max() limit: integer) {
      200: Container
      401: Problem
    }
  }
}