schema Date = string#date

schema Booking = {
  delivery: string#date
  address: string
}

schema ContainerId = string

schema Container = {
  id: ContainerId
  tare: integer
  gross: integer
}

Problem = {
  description: string
}

api ContainerApi "0.0.1" {
  path "/containers" {
    GET listContainers(@Query @Max(100) limit?: Int64) {
      200 => Container
      401 => Problem
    }
  }
}